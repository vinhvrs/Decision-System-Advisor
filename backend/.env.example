# Decision System Advisor — backend / Python engine
# Copy locally/server-side: cp backend/.env.example backend/.env
# IMPORTANT: backend/.env is gitignored. Keep real credentials out of Git.
# Generate APP_KEY: cd backend && php artisan key:generate

APP_NAME=DSA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:1111
APP_PORT=1111
LIMIT=20
# dev → demo tables (*_demo, snapshot_demo); production → production tables
DEV_MODE=dev

# --- MySQL ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dsa
DB_USERNAME=root
DB_PASSWORD=root
# Python on host only:
# DB_HOST_PYTHON=127.0.0.1

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Redis ---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_USERNAME=
REDIS_DB=0

# --- Search & vectors ---
ELASTIC_HOST=http://elasticsearch:9200
ELASTIC_INDEX=dsa_entities
ELASTIC_INDEX_COMPANY=company_profiles
ELASTIC_INDEX_NEWS=news_articles

QDRANT_URL=http://dsa-qdrant:6333
QDRANT_COLLECTION=knowledge_chunks_v1
# Python on host:
# QDRANT_URL_PYTHON=http://127.0.0.1:6333

# --- Python engine ---
PYTHON_ENGINE_URL=http://data-engine:8000
ENGINE_INTERNAL_TRIGGER_SECRET=change-me-local-dev
EMBEDDING_URL=http://127.0.0.1:8000

# --- Mail / alert delivery ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=committee@example.com
MAIL_FROM_NAME="${APP_NAME}"
# Fill only when server-side email alerts are enabled.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
ALERT_EMAIL_ENABLED=false

# ============================================================
# DATA SOURCES REQUIRED BY THE CURRENT FRONTEND CONTRACT
# Empty credentials are intentional placeholders.
# ============================================================

# --- SEC EDGAR: financials, filings, Form 4, 13F, documents ---
# No API key. SEC requests should identify the application/operator.
SEC_USER_AGENT=Decision-System-Advisor/1.0 contact@example.com
SEC_CONTACT_EMAIL=contact@example.com
SEC_BASE_URL=https://data.sec.gov
SEC_ARCHIVES_BASE_URL=https://www.sec.gov/Archives

# --- US Treasury: nominal + real yield curves ---
# No API key.
US_TREASURY_ENABLED=true
US_TREASURY_BASE_URL=https://home.treasury.gov
US_TREASURY_FISCALDATA_BASE_URL=https://api.fiscaldata.treasury.gov

# --- BLS: CPI, payrolls, unemployment, wages ---
# Public v2 API works without registration; fill the key for registered limits.
BLS_API_KEY=
BLS_BASE_URL=https://api.bls.gov/publicAPI/v2

# --- BEA: GDP, PCE, income, NIPA ---
# Required: obtain a BEA UserID/API key.
BEA_API_KEY=
BEA_USER_ID=
BEA_BASE_URL=https://apps.bea.gov/api/data

# --- EIA: oil/gas inventories, production, energy macro ---
EIA_API_KEY=
EIA_BASE_URL=https://api.eia.gov/v2

# --- GDELT: news metadata/entity/country/image enrichment ---
# No API key.
GDELT_ENABLED=true
GDELT_DOC_API_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc

# --- CFTC COT: futures positioning ---
# Public API usually works without a token. Optional Socrata app token improves identification/limits.
CFTC_APP_TOKEN=
CFTC_BASE_URL=https://publicreporting.cftc.gov

# --- FRED / ALFRED: macro aggregation + vintages ---
# Use only series whose redistribution rights have been reviewed.
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred
ALFRED_BASE_URL=https://api.stlouisfed.org/fred

# --- FINRA: short-interest / short-sale datasets ---
# Leave blank until the selected dataset/API entitlement is confirmed.
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=
FINRA_API_KEY=
FINRA_BASE_URL=https://api.finra.org

# --- Primary commercial market-data provider ---
# Choose a provider whose commercial/public-display license matches production use.
MARKET_DATA_PROVIDER=massive
MARKET_DATA_COMMERCIAL_LICENSE_CONFIRMED=false

# Massive / Polygon: US equities/options/history/corporate actions.
# Production/public use requires the appropriate business/commercial agreement.
MASSIVE_API_KEY=
POLYGON_API_KEY=

# Additional market/fundamental/estimate vendors already supported or planned.
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=

# --- Corporate earnings / estimates ---
# No dedicated free-production source is assumed.
# Configure one licensed source and map its credentials above/below.
ESTIMATES_PROVIDER=
ESTIMATES_API_KEY=
ESTIMATES_CLIENT_ID=
ESTIMATES_CLIENT_SECRET=
CORPORATE_EVENTS_PROVIDER=
CORPORATE_EVENTS_API_KEY=

# --- US equity options / OPRA-capable feed ---
# Fill only after market-data and display entitlements are confirmed.
OPTIONS_DATA_PROVIDER=
OPTIONS_API_KEY=
OPTIONS_CLIENT_ID=
OPTIONS_CLIENT_SECRET=
OPTIONS_OPRA_ENTITLED=false

# --- Crypto market / derivatives adapters ---
# Public market-data endpoints may not need credentials.
# Do not enable public redistribution until the applicable license review is complete.
CRYPTO_PUBLIC_REDISPLAY_LICENSE_CONFIRMED=false

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_BASE_URL=https://api.bybit.com

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_BASE_URL=https://www.okx.com

DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
DERIBIT_BASE_URL=https://www.deribit.com

# --- News vendors / fallbacks ---
GNEWS_API_KEY=
NEWSAPIORG_KEY=
NEWSDATA_API_KEY=
NEWSAPI_KEY=

# --- Optional vendor-specific generic credential slots ---
DATA_VENDOR_CLIENT_ID=
DATA_VENDOR_CLIENT_SECRET=
DATA_VENDOR_USERNAME=
DATA_VENDOR_PASSWORD=

# --- Source feature switches ---
ENABLE_SEC_INGEST=true
ENABLE_TREASURY_INGEST=true
ENABLE_BLS_INGEST=true
ENABLE_BEA_INGEST=false
ENABLE_EIA_INGEST=false
ENABLE_GDELT_INGEST=true
ENABLE_CFTC_INGEST=true
ENABLE_FRED_INGEST=false
ENABLE_FINRA_INGEST=false
ENABLE_MARKET_HISTORY_INGEST=true
ENABLE_ESTIMATES_INGEST=false
ENABLE_OPTIONS_INGEST=false
ENABLE_CRYPTO_INGEST=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Indicator defaults ---
INDICATOR_DEFAULT_PERIOD=daily
INDICATOR_SMA_PERIOD=14
INDICATOR_EMA_PERIOD=14
INDICATOR_RSI_PERIOD=14
INDICATOR_MACD_FAST_PERIOD=12
INDICATOR_MACD_SLOW_PERIOD=26
INDICATOR_MACD_SIGNAL_PERIOD=9
INDICATOR_STOCHASTIC_K_PERIOD=14
INDICATOR_STOCHASTIC_D_PERIOD=3
INDICATOR_BOLLINGER_PERIOD=20
INDICATOR_BOLLINGER_STD_DEV_MULTIPLIER=2.0
