APP_NAME=DSA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:1111
APP_TIMEZONE=Asia/Ho_Chi_Minh

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dsa
DB_USERNAME=dsa_user
DB_PASSWORD=dsa_password
MYSQL_ROOT_PASSWORD=root

CACHE_STORE=redis
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CONNECT_TIMEOUT=3
REDIS_READ_TIMEOUT=3

ELASTIC_HOST=http://elasticsearch:9200
ELASTIC_INDEX=dsa_entities

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge_chunks_v1

EMBEDDING_SERVICE_URL=http://data-engine:8000
EMBEDDING_URL=http://127.0.0.1:8000

MAIL_MAILER=log
MAIL_FROM_ADDRESS=demo@example.com
MAIL_FROM_NAME="${APP_NAME}"

# External market/news providers. Leave blank until you need the feature.
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
GNEWS_API_KEY=
NEWSAPI_KEY=
MASSIVE_API_KEY=
NEWSAPIORG_KEY=
NEWSDATA_API_KEY=

# Python data-engine local defaults
LIMIT=300
SCHEDULE_INTERVAL_HOURS=3
NEWS_INTERVAL_HOURS=1
NEWS_EMBED_ENABLED=0
NEWS_EMBED_INTERVAL_HOURS=1
NEWS_EMBED_BATCH_LIMIT=50
NEWS_SCHEDULE_LOOKBACK_DAYS=14
SYMBOL_INGEST_MODE=top_snapshot
SYMBOL_INGEST_TOP_N=20
SCHEDULER_MISFIRE_GRACE_SEC=14400
