# Decision System Advisor — backend / Python engine (committee local test)
# Copy: cp backend/.env.example backend/.env
# Generate APP_KEY: cd backend && php artisan key:generate

APP_NAME=DSA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:1111
APP_PORT=1111
LIMIT=20
# dev → demo tables (*_demo, snapshot_demo); production → production tables
DEV_MODE=dev

# --- MySQL (docker compose service: db, published port 3307 on host) ---
DB_CONNECTION=mysql
# Laravel in Docker: use db. PHP/Python on host: 127.0.0.1 and port 3307.
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dsa
DB_USERNAME=root
DB_PASSWORD=root
# Python on host only (when DB_HOST=host.docker.internal in .env):
# DB_HOST_PYTHON=127.0.0.1

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Redis (optional; omit or use database cache above for minimal setup) ---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_USERNAME=
REDIS_DB=0

# --- Search & vectors (docker compose: elasticsearch, qdrant) ---
ELASTIC_HOST=http://elasticsearch:9200
ELASTIC_INDEX=dsa_entities
ELASTIC_INDEX_COMPANY=company_profiles
ELASTIC_INDEX_NEWS=news_articles

QDRANT_URL=http://dsa-qdrant:6333
QDRANT_COLLECTION=knowledge_chunks_v1
# Python on host: QDRANT_URL_PYTHON=http://127.0.0.1:6333

# --- Python engine (Laravel → FastAPI internal tasks) ---
PYTHON_ENGINE_URL=http://data-engine:8000
ENGINE_INTERNAL_TRIGGER_SECRET=change-me-local-dev
EMBEDDING_URL=http://127.0.0.1:8000

# --- Mail (optional for contact / admin notifications) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=committee@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Market / news API keys (optional; ingest jobs skip or degrade without them) ---
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
GNEWS_API_KEY=
NEWSAPIORG_KEY=
NEWSDATA_API_KEY=
NEWSAPI_KEY=
MASSIVE_API_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Indicator defaults (fallback; prefer Admin → Indicator params in DB) ---
INDICATOR_DEFAULT_PERIOD=daily
INDICATOR_SMA_PERIOD=14
INDICATOR_EMA_PERIOD=14
INDICATOR_RSI_PERIOD=14
INDICATOR_MACD_FAST_PERIOD=12
INDICATOR_MACD_SLOW_PERIOD=26
INDICATOR_MACD_SIGNAL_PERIOD=9
INDICATOR_STOCHASTIC_K_PERIOD=14
INDICATOR_STOCHASTIC_D_PERIOD=3
INDICATOR_BOLLINGER_PERIOD=20
INDICATOR_BOLLINGER_STD_DEV_MULTIPLIER=2.0
